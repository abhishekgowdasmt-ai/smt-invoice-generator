# Zoho Sheet Integration Settings (India DC)
# Client id/secret/refresh token stay in Render env or local .env — never commit them.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_SPREADSHEET_ID=wx4flb9932735a31d4f8ba038c6ec4a69c850

# RAC dispatch uses extra worksheets in the same spreadsheet:
# RAC_Drivers, RAC_Bookings, RAC_Assignments, RAC_Uploads, RAC_Messages
# Website inquiries still go to Sheet1.

# Public website URL for SEO canonical tags
# PUBLIC_SITE_URL=https://www.shreemaruthitravels.com

# STAFF_TOKEN and RAC_JWT_SECRET are required. Each must be a different random value of at least 32 characters.
# Do not commit the values.
# STAFF_TOKEN=
# RAC_JWT_SECRET=

# Local development PostgreSQL only. Leave this unset in production.
# The running website keeps SQLite, JSON, and Zoho until a later cutover.
# SMT_DEV_DATABASE_URL=postgresql://smt_app:password@127.0.0.1:5432/smt_dev
# Local owner id used only to open the first owner transaction. Leave unset in production.
# SMT_DEV_BOOTSTRAP_OWNER_ID=
# Optional Booking OCR ingest service (tools/wa_booking_ingest).
# Same secret as ingest WEBSITE_API_KEY. Generate a long random string.
RAC_INGEST_KEY=
# URL the RAC website uses to reach the OCR ingest service (same container).
# Production AIC: http://127.0.0.1:8787  (server-side proxy, not the browser)
OCR_INGEST_URL=http://127.0.0.1:8787
OCR_INGEST_KEY=

# External OCR (same AIC app env). Never put these in the frontend.
# auto = Gemini if GEMINI_API_KEY, else OCR.space if OCR_SPACE_API_KEY, else Tesseract.
OCR_PROVIDER=auto
GEMINI_API_KEY=
OCR_SPACE_API_KEY=

# Booking OCR WorkDrive folder RAC_Bookings_OCR — same AIC app env as the website.
# Do not put WorkDrive OCR secrets in ZOHO_REFRESH_TOKEN.

# Google Sign-In (required). PIN login is removed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STAFF_EMAILS=abhishekgowdasmt@gmail.com,shreemaruthitravels5999@gmail.com,bhaskarbhaskarreddy9005@gmail.com
OD_EMAILS=abhishekgowdasmt@gmail.com,shreemaruthitravels5999@gmail.com
# STAFF_EXTRA_EMAILS=

# OD ledger (private-workspace). Do not overwrite SMT ZOHO_REFRESH_TOKEN.
LEDGER_ZOHO_CLIENT_ID=
LEDGER_ZOHO_CLIENT_SECRET=
LEDGER_ZOHO_REFRESH_TOKEN=
LEDGER_ZOHO_RESOURCE_ID=
LEDGER_ZOHO_API_BASE=https://sheet.zoho.in/api/v2
LEDGER_ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# Zoho WorkDrive (India) — My Folders. Trip PDFs go to Trip_Sheets, invoices to Invoices.
WORKDRIVE_REFRESH_TOKEN=
WORKDRIVE_FOLDER_ID=fdt9ecc0dfce8be504750a9fd402ab05c6ff8

# SMTP Configuration (Optional, for email notifications)
