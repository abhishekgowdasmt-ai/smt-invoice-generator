ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_SPREADSHEET_ID=wx4flb9932735a31d4f8ba038c6ec4a69c850

# RAC dispatch uses extra worksheets in the same spreadsheet:
# RAC_Drivers, RAC_Bookings, RAC_Assignments, RAC_Uploads, RAC_Messages
# Website inquiries still go to Sheet1.

# Public website URL for SEO canonical tags
# PUBLIC_SITE_URL=https://www.shreemaruthitravels.com

# Optional staff secrets (defaults work locally)
# RAC_PASSWORD=Admin@12345
# RAC_JWT_SECRET=
# Optional Booking OCR ingest service (tools/wa_booking_ingest).
# Same secret as ingest WEBSITE_API_KEY. Generate a long random string.
RAC_INGEST_KEY=
# URL the RAC website uses to reach the OCR ingest service (same container).
# Production AIC: http://127.0.0.1:8787  (server-side proxy, not the browser)
OCR_INGEST_URL=http://127.0.0.1:8787
OCR_INGEST_KEY=

# Booking OCR WorkDrive folder RAC_Bookings_OCR — same AIC app env as the website.
# Do not put WorkDrive OCR secrets in ZOHO_REFRESH_TOKEN.

