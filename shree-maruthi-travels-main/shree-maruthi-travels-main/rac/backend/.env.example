# Backend Environment Configuration
# Copy this file to .env and update with actual values

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dispatch_db
DB_USER=dispatch_user
DB_PASSWORD=changemepassword
DATABASE_URL=postgresql://dispatch_user:changemepassword@localhost:5432/dispatch_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d

# Server
PORT=3000
NODE_ENV=development

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# WhatsApp Provider - Choose ONE: gupshup OR twilio

# Option 1: Gupshup (Recommended for India 🇮🇳)
# WHATSAPP_PROVIDER=gupshup
# GUPSHUP_API_KEY=your_gupshup_api_key
# GUPSHUP_APP_ID=your_gupshup_app_id
# GUPSHUP_PHONE_NUMBER=9019933599

# Option 2: Twilio (Global)
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+919019933599
# TWILIO_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/whatsapp

# Option 3: Free Web JS (Unofficial)
# Note: Requires scanning QR code from backend terminal on startup!
WHATSAPP_PROVIDER=wwebjs

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/dispatch.log

# Redis (for message queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
