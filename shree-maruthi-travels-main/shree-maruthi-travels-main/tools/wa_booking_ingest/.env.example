# Booking OCR ingest
# Copy to .env. Never put real secrets in this file.

# -----------------------------------------------------------------------------
# REQUIRED FOR METHOD 1 — website upload → OCR → RAC website
# -----------------------------------------------------------------------------
WEBSITE_API_URL=https://www.shreemaruthitravels.com/api/v1
WEBSITE_API_KEY=
# auto = Gemini if GEMINI_API_KEY, else OCR.space if OCR_SPACE_API_KEY, else Tesseract.
# Keys stay on the server. Never put them in the website frontend.
OCR_PROVIDER=auto
OCR_SPACE_API_KEY=
# OCR_SPACE_URL=https://api.ocr.space/parse/image
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
LOG_LEVEL=INFO
WHATSAPP_WATCHER_ENABLED=0
# Optional if tesseract.exe is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# If the RAC website is on another machine, bind the ingest API:
# DASHBOARD_HOST=0.0.0.0
# INGEST_REQUIRE_KEY=1

# -----------------------------------------------------------------------------
# REQUIRED FOR METHOD 2 — Zoho WorkDrive folder RAC_Bookings_OCR
# Do not reuse ZOHO_REFRESH_TOKEN (that is Zoho Sheet).
# Client id/secret may fall back to ZOHO_CLIENT_ID / ZOHO_CLIENT_SECRET.
# Refresh token may fall back to WORKDRIVE_REFRESH_TOKEN (trip sheets), never Sheet.
# -----------------------------------------------------------------------------
ZOHO_WORKDRIVE_ENABLED=1
ZOHO_WORKDRIVE_FOLDER_ID=
ZOHO_WORKDRIVE_CLIENT_ID=
ZOHO_WORKDRIVE_CLIENT_SECRET=
ZOHO_WORKDRIVE_REFRESH_TOKEN=
ZOHO_WORKDRIVE_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_WORKDRIVE_API_BASE=https://www.zohoapis.in/workdrive/api/v1
WORKDRIVE_POLL_SECONDS=60

# Production (same AIC container as RAC): start.sh runs
# python -m tools.wa_booking_ingest --http on OCR_HTTP_PORT=8787
# Local development: start.bat (Flask dashboard on DASHBOARD_PORT, default 8787)
# TESSERACT_CMD=/usr/bin/tesseract
# OCR_HTTP_PORT=8787
